第一磁极：273.8 N/m（76.4%）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color='#991B1B'&gt;第二磁极：150.2 − 69.8 = 80.4 N/m（22.4%）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color='#DC2626'&gt;反向项抵消约46.5%&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="105" y="1025" width="1005" height="145" as="geometry" /></mxCell><mxCell id="target" value="&lt;b&gt;目标：第二磁极占比35%–45%&lt;/b&gt;&lt;br&gt;&lt;b&gt;反向项低于20%；永磁体体积不增加&lt;/b&gt;&lt;br&gt;浅磁障仅在极宽、位置和倒角优化无效时采用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86B999;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1290" y="1025" width="1005" height="145" as="geometry" /></mxCell><mxCell id="c_width" value="极宽±10%/±20%" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1310" y="220" width="330" height="55" as="geometry" /></mxCell><mxCell id="c_shift" value="轴向位置±2.5/±5 mm" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1930" y="220" width="330" height="55" as="geometry" /></mxCell><mxCell id="c_root" value="加厚极根" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1320" y="950" width="330" height="55" as="geometry" /></mxCell><mxCell id="c_edge" value="极边倒角或圆角" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1940" y="950" width="330" height="55" as="geometry" /></mxCell><mxCell id="lead_width" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_width" target="bp2u"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="247" /><mxPoint x="1690" y="415" /></Array></mxGeometry></mxCell><mxCell id="lead_shift" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_shift" target="bp2u"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2095" y="300" /><mxPoint x="1900" y="300" /></Array></mxGeometry></mxCell><mxCell id="lead_root" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_root" target="bp2l"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="977" /><mxPoint x="1680" y="900" /></Array></mxGeometry></mxCell><mxCell id="lead_edge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_edge" target="bp2l"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2240" y="977" /><mxPoint x="2240" y="825" /></Array></mxGeometry></mxCell><mxCell id="explain" value="&lt;b&gt;反向应力的含义&lt;/b&gt;&lt;br&gt;当气隙法向磁密 BY 与轴向磁密 BZ 的乘积为负时，局部 tZ = BY·BZ/μ0 指向目标推力的反方向。&lt;br&gt;它是局部电磁牵引力，不是机械内应力；第二磁极的净推力仍为正，但部分有效作用被抵消。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#94A3B8;strokeWidth=2;align=left;verticalAlign=middle;spacing=18;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="45" y="1240" width="2310" height="205" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
