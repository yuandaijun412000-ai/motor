<mxfile host="app.diagrams.net" modified="2026-10-02T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="oscillation-symmetry" name="振荡对称性">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="振荡电机的对称性与瞬时 Maxwell 牵引力" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="1460" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="结构保持镜像对称；瞬时电流与位置决定当时的磁场和推力方向" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="560" y="78" width="1280" height="42" as="geometry" /></mxCell><mxCell id="pa" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="1120" height="920" as="geometry" /></mxCell><mxCell id="pb" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1205" y="125" width="1150" height="520" as="geometry" /></mxCell><mxCell id="pc" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1205" y="675" width="1150" height="370" as="geometry" /></mxCell><mxCell id="pd" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="1075" width="2310" height="370" as="geometry" /></mxCell><mxCell id="at" value="A  相隔半个周期的两个瞬时状态" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="260" y="145" width="690" height="55" as="geometry" /></mxCell><mxCell id="state1" value="&lt;b&gt;时刻 t&lt;/b&gt;&lt;br&gt;z(t)&amp;gt;0，i(t)=+I&lt;br&gt;&lt;font color='#166534'&gt;&lt;b&gt;净力 +Z&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#DC2626'&gt;允许局部 −Z 牵引&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="125" y="250" width="920" height="260" as="geometry" /></mxCell><mxCell id="half" value="z(t+T/2)=−z(t)，i(t+T/2)=−i(t)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="160" y="555" width="850" height="60" as="geometry" /></mxCell><mxCell id="state2" value="&lt;b&gt;时刻 t+T/2&lt;/b&gt;&lt;br&gt;结构仍保持镜像对称&lt;br&gt;&lt;font color='#166534'&gt;&lt;b&gt;净力 −Z&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#DC2626'&gt;局部牵引分布随状态镜像变化&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="125" y="660" width="920" height="260" as="geometry" /></mxCell><mxCell id="bt" value="B  反向牵引的正确含义" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="1425" y="145" width="710" height="55" as="geometry" /></mxCell><mxCell id="btext" value="在以 Y 为法向的气隙面上：&lt;br&gt;&lt;b&gt;&lt;font color='#1D4ED8'&gt;tZ = BY·BZ / μ0&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;BY·BZ&amp;lt;0 表示该局部面元与当时净推力方向相反。闭合积分面允许同时存在正、负区域，判断依据是动子总力积分。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="225" width="1040" height="235" as="geometry" /></mxCell><mxCell id="brule" value="&lt;b&gt;&lt;font color='#9A3412'&gt;结构修改规则&lt;/font&gt;&lt;/b&gt;&lt;br&gt;左右极宽同步改变；轴向位置镜像改变；倒角和磁障成对镜像设置。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;fillColor=#FFF7ED;strokeColor=#FDBA74;" vertex="1" parent="1"><mxGeometry x="1260" y="485" width="1040" height="115" as="geometry" /></mxCell><mxCell id="ct" value="C  用 ±I、0 A 检查振荡对称性" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1405" y="695" width="750" height="55" as="geometry" /></mxCell><mxCell id="ctext" value="&lt;b&gt;F0(z) = F(z,0)&lt;/b&gt;&lt;br&gt;&lt;font color='#166534'&gt;&lt;b&gt;Fodd(z) = [F(z,+I) − F(z,−I)] / 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#9A3412'&gt;&lt;b&gt;Feven(z) = [F(z,+I) + F(z,−I)] / 2 − F0(z)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;对称关系：F0(−z)≈−F0(z)，Fodd(−z)≈Fodd(z)&lt;br&gt;等价检验：F(z,+I)≈−F(−z,−I)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="765" width="1040" height="240" as="geometry" /></mxCell><mxCell id="dt" value="D  已有 ±1 A、0 A 数据的分解结果" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="1090" width="850" height="55" as="geometry" /></mxCell><mxCell id="dleft" value="&lt;b&gt;&lt;font color='#166534'&gt;Fodd 为主要推力分量&lt;/font&gt;&lt;/b&gt;&lt;br&gt;平均 Fodd = 12.690 N&lt;br&gt;峰峰值 = 0.563 N（4.44%）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1170" width="960" height="190" as="geometry" /></mxCell><mxCell id="dright" value="&lt;b&gt;对称性误差较小&lt;/b&gt;&lt;br&gt;Fodd 左右不对称最大值 = 0.074 N（0.58%）&lt;br&gt;组合对称关系最大残差 = 0.135 N（1.06%）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=26;fontFamily=Microsoft YaHei;align=left;spacing=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="1170" width="1020" height="190" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>